# Образец настроек. Скопируй этот файл в backend/.env и впиши свои значения.
# Файл .env в git не попадает, поэтому ключи и пароли никто не увидит.
# На Render этот файл не нужен: те же переменные задаются в разделе Environment.

# --- База данных ---
# Пусто — используется файл SQLite backend/training.db (удобно у себя на компьютере).
# На хостинге — строка подключения к Postgres из Neon.
DATABASE_URL=

# --- Письма (подтверждение почты и смена пароля) ---
# Если не задано ни BREVO_API_KEY, ни SMTP_HOST, письма не отправляются,
# а ссылка печатается в терминал, где запущен сервер.

# Способ 1: Brevo (нужен на бесплатном Render — там SMTP закрыт).
# MAIL_FROM должен быть подтверждён в Brevo (раздел Senders).
# Для SMTP его можно не заполнять — возьмётся SMTP_USER.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Training

# Способ 2: обычный почтовый сервер (работает у себя на компьютере).
# Яндекс:  SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465
# Mail.ru: SMTP_HOST=smtp.mail.ru    SMTP_PORT=465
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
# Пароль — не обычный пароль от почты, а «пароль приложения»
# (создаётся в настройках безопасности почтового ящика).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Адреса ---
# Адрес этого сервера (из него собирается ссылка в письме)
API_URL=http://127.0.0.1:5000
# Адрес сайта (сюда человек попадёт по ссылке из письма)
SITE_URL=http://localhost:8000
# Дополнительные сайты, которым можно обращаться к серверу (через запятую), например адрес на Vercel
ALLOWED_ORIGINS=

# На хостинге поставь DEBUG=0
DEBUG=1
